{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:serve": "wait-on http://localhost:5173 && electron .",
    "electron:dev": "concurrently -k \"npm:dev\" \"npm:electron:serve\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:pack": "npm run electron:build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.timedesk.app",
    "productName": "TimeDesk",
    "copyright": "Copyright © 2026 TimeDesk",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": "always",
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
